opam-version: "2.0"
name: "springer-book-example"
version: "dev"
maintainer: "Liang Wang <ryanrhymes@gmail.com>"
homepage: "https://github.com/owlbarn/springer-book-code"
bug-reports: "https://github.com/owlbarn/springer-book-code"
synopsis: "Owl Springer Book code examples"
depends: [
  "ocaml" {>= "4.10.0"}
  "dune" {>= "2.9.0"}
  "owl"
  "owl-plplot"
  "owl-ode"
  "owl-ode-odepack"
  "camlimages" {= "5.0.5"}
  "base" {< "v0.17"}
  "stdio" {< "v0.17"}
]
build: ["dune" "build"]
depexts: []
dev-repo: "git+https://github.com/owlbarn/springer-book-code.git"
